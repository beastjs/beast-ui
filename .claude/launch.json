{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "docs",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
