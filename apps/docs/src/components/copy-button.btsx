import { COPY_FAILED_MESSAGE, useCopy } from "../hooks/use-copy";
import { cn } from "../lib/utils";
import AnimatedIcon from "./animated-icon.btsx";

module
  const roundedClasses = {
    full: "rounded-full",
    md: "rounded-md",
  }
  const labels = {
    copied: "Copied",
    failed: COPY_FAILED_MESSAGE,
    idle: "Copy to clipboard",
  }

props { className, iconClassName, rounded = "md", text, }: { className?: string; iconClassName?: string; rounded?: keyof typeof roundedClasses; text: string }
setup
  const { copy, status } = useCopy();
  const copied = status === "copied";
button(
  ~ aria-label={labels[status]}
  ~ className={cn("group grid size-7 shrink-0 place-items-center transition-[scale,background-color] duration-200 ease-out hover-hover:hover:bg-background-hovered active:scale-[0.97]", roundedClasses[rounded], className)}
  ~ onClick={() => copy(text)}
  ~ type="button"
  ~ )
  AnimatedIcon(
    ~ active={copied}
    ~ activeIcon={Icon(name="copied" className={cn("size-4 text-content-subtle will-change-transform", iconClassName)}) }
    ~ idleIcon={Icon(name="copy" className={cn("size-4 text-content-subtle transition-colors duration-200 ease-out will-change-transform group-hover:text-content", iconClassName)})}
    ~ )
  span.sr-only(role="status")
    if status === "idle"
      | #{""}
    else
      | #{labels[status]}
