import { type OctaneNode } from "octane";
props { children, label }: { children: OctaneNode; label: string }
section(className="showcase-preview relative z-10 mt-8 flex min-h-80 w-full items-center justify-center rounded-3xl border border-sidebar-border bg-surface p-5 shadow-xs sm:p-8" aria-label={label}) #{children}
