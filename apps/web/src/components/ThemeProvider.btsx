import { createContext, use, useEffect, useState } from 'octane'
import type { OctaneNode } from 'octane'
import { applyTheme, getPreferredTheme, saveTheme } from '@/lib/theme'
import type { Theme } from '@/lib/theme'
import {Icon} from "@/lib/icons";


component ThemeToggle
  setup
    const { theme, toggleTheme } = useTheme()
    const nextTheme = theme === 'dark' ? 'light' : 'dark'
    const title = `Switch to ${nextTheme} theme`

  button(
    ~ type='button'
    ~ className='inline-flex size-7 cursor-pointer items-center justify-center rounded-full hover:bg-muted text-foreground/70 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-foreground/30 dark:hover:bg-white/15 transition-all duration-200 ease-out active:scale-97 active:rotate-6'
    ~ onClick={toggleTheme}
    ~ aria-label='Dark theme'
    ~ aria-pressed={theme === 'dark'}
    ~ title={title}
    ~ )
    Icon(name='theme' className='size-5.5 md:size-5')

module
  interface ThemeContextValue {
    theme: Theme
    setTheme: (theme: Theme) => void
    toggleTheme: () => void
  }

  interface ThemeProviderProps {
    children?: OctaneNode
  }

  export { ThemeToggle }

  const ThemeContext = createContext<ThemeContextValue | null>(null)

  export function useTheme(): ThemeContextValue {
    const context = use(ThemeContext)
    if (context === null) throw new Error('useTheme must be used within ThemeProvider.')
    return context
  }
props { children }: ThemeProviderProps

setup
  const [theme, setThemeState] = useState<Theme>(getPreferredTheme)
  const setTheme = (nextTheme: Theme) => {
    setThemeState(nextTheme)
    saveTheme(nextTheme)
  }
  const toggleTheme = () => setTheme(theme === 'dark' ? 'light' : 'dark')
  const value: ThemeContextValue = { theme, setTheme, toggleTheme }

  useEffect(() => applyTheme(theme), [theme])

ThemeContext(value={value})
  div(className="size-screen overflow-hidden") #{children}
