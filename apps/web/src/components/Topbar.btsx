import { cn } from "../lib/utils"
import { Icon } from '@beast-ui/icons';
import Button from "./ui/Button.btsx";
import { ThemeToggle } from "./ThemeProvider.btsx";
import { Link } from "@octanejs/tanstack-router";
import { REPOSITORY_URL } from "../lib/catalog";

module
  export interface BrandProps {
    className?: string
    children?: unknown
  }

component Brand
  props { className, children }: BrandProps
  setup
    const BRAND_CLASS = "flex items-center gap-3"
    const BRAND_IMAGE_CLASS = "size-16"


  div(className={cn(BRAND_CLASS, className)})
    Link(className="flex items-center gap-0.5 font-medium tracking-tight" to="/" aria-label="Beast UI home")
      Icon(name="beast" className="size-4.5 mr-2.5 text-mist-700 dark:text-taupe-300")
      div(className='skew-2 text-mist-500 dark:text-taupe-400/80') Beast
      span(className='opacity-100 text-base font-black text-mist-700 dark:text-taupe-400 tracking-wide') UI
    div #{children}


props {}: {}
header(className="topbar sticky top-0 z-40 bg-background/10 backdrop-blur-3xl w-full w-full px-3.5 flex items-center justify-between gap-4")
  Brand
  div(className="flex items-center gap-2")
    ThemeToggle
    // Button(label="GitHub" variant='default' size="sm" type='a' href={REPOSITORY_URL} target="_blank" rel="noopener noreferrer" className="hidden md:flex")
