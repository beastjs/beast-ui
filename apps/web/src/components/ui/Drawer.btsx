import { Drawer as D } from '@octanejs/base-ui/drawer'
import type { OctaneNode, ComponentProps } from 'octane'
import { cn } from '@/lib/utils'

module
  export type DrawerSide = 'bottom' | 'left' | 'right' | 'top'
  export type DrawerSwipeDirection = 'down' | 'left' | 'right' | 'up'
  type DrawerRoot = ComponentProps<typeof D.Root>


  export interface DrawerProps extends Omit<DrawerRoot, 'children' | 'swipeDirection'> {
    /** The drawer body, rendered inside Base UI's swipe-aware content region. */
    children?: OctaneNode
    /** Accessible name announced for the drawer. */
    title: string
    /** Optional accessible description announced after the title. */
    description?: string
    /** The viewport edge the drawer is attached to. */
    side?: DrawerSide
    /**
     * Direction used to dismiss the drawer. Defaults to the direction implied
     * by `side`. The SwipeArea opens it with the opposite gesture.
     */
    swipeDirection?: DrawerSwipeDirection
    /** A trigger rendered inside Drawer.Root and outside the portal. */
    trigger?: OctaneNode
    /** Set false when a drawer should only be opened by its trigger. */
    swipeToOpen?: boolean
    /** Set true to render an accessible close button in the panel. */
    showCloseButton?: boolean
    className?: string
    contentClassName?: string
    backdropClassName?: string
    viewportClassName?: string
    swipeAreaClassName?: string
  }

  const DISMISS_DIRECTION: Record<DrawerSide, DrawerSwipeDirection> = {
    bottom: 'down',
    left: 'left',
    right: 'right',
    top: 'up'
  }

  const SWIPE_AREA_CLASS_NAME: Record<DrawerSide, string> = {
    bottom: 'fixed inset-x-0 bottom-0 h-6',
    left: 'fixed inset-y-0 left-0 w-6',
    right: 'fixed inset-y-0 right-0 w-6',
    top: 'fixed inset-x-0 top-0 h-6'
  }

  const VIEWPORT_CLASS_NAME: Record<DrawerSide, string> = {
    bottom: 'items-end justify-center',
    left: 'items-stretch justify-start',
    right: 'items-stretch justify-end',
    top: 'items-start justify-center'
  }

  const POPUP_CLASS_NAME: Record<DrawerSide, string> = {
    bottom: 'max-h-[min(85dvh,48rem)] w-full rounded-t-2xl border-t [transform:translateY(var(--drawer-swipe-movement-y))] data-ending-style:translate-y-full data-starting-style:translate-y-full',
    left: 'h-full w-[min(20rem,calc(100vw-3rem))] border-r [transform:translateX(var(--drawer-swipe-movement-x))] data-ending-style:-translate-x-full data-starting-style:-translate-x-full',
    right: 'h-full w-[min(20rem,calc(100vw-3rem))] border-l [transform:translateX(var(--drawer-swipe-movement-x))] data-ending-style:translate-x-full data-starting-style:translate-x-full dark:bg-card/55',
    top: 'max-h-[min(85dvh,48rem)] w-full rounded-b-2xl border-b [transform:translateY(var(--drawer-swipe-movement-y))] data-ending-style:-translate-y-full data-starting-style:-translate-y-full'
  }

  const BASE_BACKDROP_CLASS_NAME =
    'fixed inset-0 z-40 min-h-dvh bg-black/40 opacity-[calc(1-var(--drawer-swipe-progress))] backdrop-blur-[1px] transition-opacity duration-300 ease-out data-swiping:duration-0 data-ending-style:opacity-0 data-starting-style:opacity-0 motion-reduce:transition-none'
  const BASE_VIEWPORT_CLASS_NAME = 'pointer-events-none fixed inset-0 z-50 flex'
  const BASE_POPUP_CLASS_NAME =
    'pointer-events-auto relative flex flex-col overflow-hidden overscroll-contain border-border/70 bg-background text-foreground shadow-2xl outline-none transition-transform duration-300 ease-out data-swiping:select-none data-swiping:duration-0 motion-reduce:transition-none'
  const BASE_CONTENT_CLASS_NAME = 'flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain dark:bg-sunken/80 backdrop-blur-3xl'

  /** Base UI parts are re-exported so advanced callers can compose custom drawers. */
  export const DrawerRoot = D.Root
  export const DrawerTrigger = D.Trigger
  export const DrawerPortal = D.Portal
  export const DrawerBackdrop = D.Backdrop
  export const DrawerViewport = D.Viewport
  export const DrawerPopup = D.Popup
  export const DrawerContent = D.Content
  export const DrawerTitle = D.Title
  export const DrawerDescription = D.Description
  export const DrawerClose = D.Close
  export const DrawerSwipeArea = D.SwipeArea
  export const DrawerProvider = D.Provider
  export const DrawerIndent = D.Indent
  export const DrawerIndentBackground = D.IndentBackground
  export const DrawerVirtualKeyboardProvider = D.VirtualKeyboardProvider
  export const createDrawerHandle = D.createHandle

props { children, title, description, side = 'right', swipeDirection, trigger, swipeToOpen = true, showCloseButton = false, className, contentClassName, backdropClassName, viewportClassName, swipeAreaClassName, modal = true, ...rootProps }: DrawerProps
setup const resolvedSwipeDirection = swipeDirection ?? DISMISS_DIRECTION[side]

D.Root(swipeDirection={resolvedSwipeDirection} modal={modal} {...rootProps})
  | #{trigger}
  if swipeToOpen
    D.SwipeArea(className={cn('z-30 touch-none', SWIPE_AREA_CLASS_NAME[side], swipeAreaClassName)})
  D.Portal
    D.Backdrop(className={cn(BASE_BACKDROP_CLASS_NAME, backdropClassName)})
    D.Viewport(className={cn(BASE_VIEWPORT_CLASS_NAME, VIEWPORT_CLASS_NAME[side], viewportClassName)})
      D.Popup(className={cn(BASE_POPUP_CLASS_NAME, POPUP_CLASS_NAME[side], className)})
        D.Content(className={cn(BASE_CONTENT_CLASS_NAME, contentClassName)})
          D.Title(className='sr-only') #{title}
          if description
            D.Description(className='sr-only') #{description}
          if showCloseButton
            D.Close(type='button' aria-label='Close drawer' className='absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full text-xl leading-none text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring') ×
          | #{children}
