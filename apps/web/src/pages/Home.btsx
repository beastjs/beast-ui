import { Link } from "@octanejs/tanstack-router";
import { CLI, componentTree, REGISTRY_URL } from "../lib/catalog";
import { componentHref } from "../lib/navs";


module
  const setupCommands = [
    `${CLI} init`,
    `${CLI} add button --dry-run`,
    `${CLI} add button`,
  ].join("\n")

props {}:{}
div(className="mx-auto max-w-4xl px-5 py-10 md:px-10 md:py-14")
  section(className='grid grid-cols-1 md:grid-cols-2 gap-8 my-8 rounded-3xl dark:bg-sidebar-accent/50')
    div(className="flex items-center justify-center h-64 w-140 bg-surface rounded-xl border border-sidebar-border")
    // div(className="flex items-center justify-center size-64 bg-surface rounded-xl border border-sidebar-border")

  section(aria-labelledby="intro-title")
    p(className="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground") The Beast component registry
    h1#intro-title(className="max-w-2xl text-4xl font-medium leading-[1.06] tracking-[-0.04em] md:text-5xl") Your components. Your source.
    p(className="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground") Accessible UI for Beast and Octane. Add the source to your project, make it your own, and build from there.

  section(className='h-96 grid grid-cols-1 md:grid-cols-2 gap-8 my-8 dark:bg-sidebar-accent/50')
    div(className="flex items-center justify-center h-96 w-120 bg-surface dark:bg-card rounded-xl border dark:border-chart-5 border-sidebar-border")
    // div(className="flex items-center justify-center size-64 bg-surface dark:bg-card rounded-xl border dark:border-chart-5/0 border-sidebar-border")
  section(className="mt-12" aria-labelledby="start-title")
    h2#start-title(className="text-xl font-medium tracking-tight") Get started
    p(className="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground") Start with a Beast + Octane app using Tailwind CSS v4. In that app, run:
    pre(className="mt-4 overflow-x-auto rounded-xl border border-border/40 bg-muted/50 p-5 font-mono text-xs leading-7")
      code #{setupCommands}
    p(className="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground") #{"Import src/styles/theme.css after Tailwind in your app stylesheet, and configure @/* to resolve to src/* in both TypeScript and your bundler."}
  section(className="mt-12" aria-labelledby="catalog-title")
    h2#catalog-title(className="text-xl font-medium tracking-tight") Components
    div(className="mt-4 grid gap-3 sm:grid-cols-2")
      each entry in componentTree key entry.item.name
        Link(to={componentHref(entry.item.name)} className="rounded-xl border border-border/40 p-5 transition-colors hover:bg-muted/60")
          h3(className="font-medium") #{entry.item.title}
          p(className="mt-2 text-sm leading-relaxed text-muted-foreground") #{entry.item.description}
          if entry.variants.length > 0
            p(className="mt-3 font-mono text-xs text-muted-foreground") #{`${entry.variants.length} ${entry.variants.length === 1 ? "variant" : "variants"}`}
    p(className="mt-6 text-xs text-muted-foreground")
      | #{"Every item is also available as JSON at "}
      a(href={`${REGISTRY_URL}/registry.json`} className="underline underline-offset-4") #{`${REGISTRY_URL}/registry.json`}
      | .
