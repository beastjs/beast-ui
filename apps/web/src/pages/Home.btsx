import { Link } from "@octanejs/tanstack-router";
import { CLI, components, REGISTRY_URL } from "@/lib/catalog";
import { componentHref } from "@/lib/navs";

module
  const setupCommands = [
    `${CLI} init --cwd ../my-app`,
    `${CLI} add button --cwd ../my-app --dry-run`,
    `${CLI} add button --cwd ../my-app`,
  ].join("\n")

props {}:{}
div(className="mx-auto max-w-4xl px-5 py-10 md:px-10 md:py-14")
  section(aria-labelledby="intro-title")
    p(className="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground") The Beast component registry
    h1#intro-title(className="max-w-2xl text-4xl font-medium leading-[1.06] tracking-[-0.04em] md:text-5xl") Your components. Your source.
    p(className="mt-5 max-w-xl text-base leading-relaxed text-muted-foreground") Accessible UI for Beast and Octane. Add the source to your project, make it your own, and build from there.
  section(className="mt-12" aria-labelledby="start-title")
    h2#start-title(className="text-xl font-medium tracking-tight") Get started
    p(className="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground") Start with a Beast + Octane app using Tailwind CSS v4. Until the CLI is on npm, run it from a beast-ui checkout. It installs from the hosted registry:
    pre(className="mt-4 overflow-x-auto rounded-xl border border-border/40 bg-muted/50 p-5 font-mono text-xs leading-7")
      code #{setupCommands}
    p(className="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground") #{"Import src/styles/theme.css after Tailwind in your app stylesheet, and configure @/* to resolve to src/* in both TypeScript and your bundler."}
  section(className="mt-12" aria-labelledby="catalog-title")
    h2#catalog-title(className="text-xl font-medium tracking-tight") Components
    div(className="mt-4 grid gap-3 sm:grid-cols-2")
      each component in components key component.name
        Link(to={componentHref(component.name)} className="rounded-xl border border-border/40 p-5 transition-colors hover:bg-muted/60")
          h3(className="font-medium") #{component.title}
          p(className="mt-2 text-sm leading-relaxed text-muted-foreground") #{component.description}
    p(className="mt-6 text-xs text-muted-foreground")
      | #{"Every item is also available as JSON at "}
      a(href={`${REGISTRY_URL}/registry.json`} className="underline underline-offset-4") #{`${REGISTRY_URL}/registry.json`}
      | .
