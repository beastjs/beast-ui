import { useState } from "octane";
import { Icon } from "@beast-ui/icons";
import Alert, { AlertTitle, AlertDescription, AlertAction } from "@beast-ui/registry/ui/alert";
import Button from "@beast-ui/registry/ui/button";

props {}:{}
setup
  const [resolved, setResolved] = useState(false)
div.preview-stack(className="max-w-lg")
  section.preview-section(aria-label="Informational alert")
    h2.preview-label A little context
    Alert
      Icon(name="copied")
      AlertTitle Your changes are saved
      AlertDescription Everything is up to date. You can safely close this window and pick up where you left off.
  section.preview-section(aria-label="Alert with an action")
    h2.preview-label Something needs attention
    Alert(variant={resolved ? "default" : "destructive"})
      Icon(name={resolved ? "copied" : "re-up"})
      AlertTitle #{resolved ? "Connection restored" : "We couldn’t sync your project"}
      AlertDescription #{resolved ? "Your local changes have been synced successfully." : "Your changes are safe on this device. Try syncing again to update your workspace."}
      AlertAction
        Button(size="xs" variant="outline" onClick={() => setResolved(!resolved)}) #{resolved ? "Reset example" : "Try again"}
