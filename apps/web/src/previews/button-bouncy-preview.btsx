import { useState } from "octane";
import { Icon } from "@beast-ui/icons";
import ButtonBouncy from "@beast-ui/registry/ui/button-bouncy";

module
  const presets = [
    { label: "Subtle", hover: 1.03, press: 0.96, stiffness: 600, damping: 24 },
    { label: "Springy", hover: 1.05, press: 0.9, stiffness: 520, damping: 14 },
    { label: "Playful", hover: 1.12, press: 0.8, stiffness: 350, damping: 8 },
  ] as const

props {}:{}
setup
  const [count, setCount] = useState(0)
div.preview-stack
  section.preview-section(aria-label="Bounce presets")
    h2.preview-label Feel the spring
    div(className="preview-row gap-8 py-5")
      each preset in presets key preset.label
        div(className="flex flex-col items-center gap-4")
          ButtonBouncy(size="lg" hoverScale={preset.hover} pressScale={preset.press} stiffness={preset.stiffness} damping={preset.damping} onClick={() => setCount(count + 1)}) #{preset.label}
          code.preview-caption #{`damping ${preset.damping}`}
  section.preview-section(aria-label="Bouncy button variants")
    h2.preview-label Same button, more personality
    div.preview-row
      ButtonBouncy(variant="outline" onClick={() => setCount(count + 1)})
        Icon(name="new-folder")
        | Create something
      ButtonBouncy(variant="secondary" onClick={() => setCount(count + 1)}) Try again
      ButtonBouncy(variant="outline" disabled={true}) Disabled
    p.preview-note(role="status") #{count === 0 ? "Hover to lift. Press and release to bounce." : `${count} ${count === 1 ? "bounce" : "bounces"}. Keep going.`}
