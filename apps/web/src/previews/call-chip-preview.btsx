import { useState } from "octane";
import Button from "@beast-ui/registry/ui/button";
import CallChip from "@beast-ui/registry/ui/call-chip";

props {}:{}
setup
  const [status, setStatus] = useState<"idle" | "running" | "done" | "error">("idle")
div.preview-stack
  section.preview-section(aria-label="Interactive tool call")
    h2.preview-label Follow a tool call
    div(className="preview-row min-h-20")
      CallChip(name="Search" argument="components" icon="search" status={status} expectedMs={3000} onRetry={() => setStatus("running")})
    div(className="preview-row gap-2")
      Button(size="sm" onClick={() => setStatus("running")} disabled={status !== "idle"}) Start
      Button(size="sm" variant="outline" onClick={() => setStatus("done")} disabled={status !== "running"}) Complete
      Button(size="sm" variant="outline" onClick={() => setStatus("error")} disabled={status !== "running"}) Fail
      Button(size="sm" variant="ghost" onClick={() => setStatus("idle")} disabled={status === "idle"}) Reset
    p.preview-note(role="status") #{status === "idle" ? "Start a call to watch its progress and elapsed time." : status === "running" ? "Running. Choose Complete or Fail to finish the call." : status === "done" ? "Complete. Reset to run it again." : "Failed. Click the chip, or press Enter or Space, to retry."}
  section.preview-section(aria-label="Tool icons and states")
    h2.preview-label Different tools, familiar states
    div.preview-row
      CallChip(name="Read" argument="theme.css" icon="file" status="idle" showTimer={false} size={28})
      CallChip(name="Edit" argument="button.btsx" icon="edit" status="done" showTimer={false} size={28})
      CallChip(name="Run" argument="bun test" icon="terminal" status="error" showTimer={false} size={28})
