import { useId, useState } from "octane";
import Checkbox from "@beast-ui/registry/ui/checkbox";

props {}:{}
setup
  const id = useId()
  const [a, setA] = useState(true)
  const [b, setB] = useState(false)
  const [c, setC] = useState(false)
  const selected = Number(a) + Number(b) + Number(c)
div.preview-stack(className="max-w-sm")
  section.preview-section(aria-label="Designing the builder")
    h2.preview-label.px-3.text-lg Designing the builder
    div.preview-card(className="flex flex-col gap-5")
      div(className="flex flex-col justify-center gap-3")
        Checkbox(
          ~ id={`${id}-self-aware`}
          ~ label="Self aware"
          ~ checked={a}
          ~ onChange={(checked: boolean) => {
          ~   void setA(checked);
          ~ }}
          ~ boxSize={20}
          ~ boxRadius={5}
          ~ fontSize={16}
          ~ bounce={0.1}
          ~ strikeLag={0.12}
          ~ doneOpacity={0.42}
          ~ strike="none"
          ~ disabled={false})

        Checkbox(
          ~ id={`${id}-examine-own-views`}
          ~ label="Examine own views"
          ~ checked={b}
          ~ onChange={(checked: boolean) => {
          ~   void setB(checked);
          ~ }}
          ~ boxSize={20}
          ~ boxRadius={5}
          ~ fontSize={16}
          ~ bounce={0.1}
          ~ strikeLag={0.012}
          ~ doneOpacity={0.42}
          ~ strike="none"
          ~ disabled={false})

        Checkbox(
          ~ id={`${id}-never-certain`}
          ~ label="Never certain"
          ~ checked={c}
          ~ onChange={(checked: boolean) => {
          ~   void setC(checked);
          ~ }}
          ~ boxSize={20}
          ~ boxRadius={5}
          ~ fontSize={16}
          ~ bounce={0.1}
          ~ strikeLag={0.12}
          ~ doneOpacity={0.42}
          ~ strike="none"
          ~ disabled={false})
    p.preview-note(role="status") #{`${selected} of 3 `}
