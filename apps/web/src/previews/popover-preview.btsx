import { useState } from "octane";
import Popover from "@beast-ui/registry/ui/popover";

props {}:{}
setup
  const [open, setOpen] = useState(false)
div(className="flex flex-col items-center gap-6")
  Popover(open={open} onOpenChange={setOpen}) Babes
  p(role="status" className="text-sm text-muted-foreground") #{open ? "Open: on." : "Open: off."}
  p(className="max-w-md text-center text-xs leading-relaxed text-muted-foreground") Popover element
