import { useId, useState } from "octane";
import { Icon } from "@beast-ui/icons";
import Popover, { PopoverContent, PopoverDescription, PopoverHeader, PopoverTitle, PopoverTrigger } from "@beast-ui/registry/ui/popover";
import { buttonVariants } from "@beast-ui/registry/ui/button";

props {}:{}
setup
  const id = useId()
  const [open, setOpen] = useState(false)
  const [width, setWidth] = useState("320")
  const [height, setHeight] = useState("180")
  const frameWidth = Math.max(1, Math.min(2000, Number(width) || 1))
  const frameHeight = Math.max(1, Math.min(2000, Number(height) || 1))
  const scale = Math.min(180 / frameWidth, 100 / frameHeight)
div.preview-stack
  section.preview-section(aria-label="Editable popover")
    h2.preview-label A small panel, right where you need it
    div(className="preview-row min-h-16")
      Popover(open={open} onOpenChange={setOpen})
        PopoverTrigger(className={buttonVariants({ variant: "outline", size: "lg" })})
          Icon(name="mechanics")
          | Dimensions
          Icon(name="chevron-down" className="size-3")
        PopoverContent(className="showcase-popover" sideOffset={10})
          PopoverHeader
            PopoverTitle Dimensions
            PopoverDescription Adjust the size of your frame. Changes appear in the preview below.
          div(className="grid grid-cols-[auto_1fr] items-center gap-3")
            label(htmlFor={`${id}-width`} className="text-xs") Width
            input.preview-input(id={`${id}-width`} type="number" min="1" max="2000" value={width} onInput={(event) => setWidth(event.currentTarget.value)})
            label(htmlFor={`${id}-height`} className="text-xs") Height
            input.preview-input(id={`${id}-height`} type="number" min="1" max="2000" value={height} onInput={(event) => setHeight(event.currentTarget.value)})
      Popover
        PopoverTrigger(className={buttonVariants({ variant: "ghost", size: "sm" })}) Quick tip
        PopoverContent(className="showcase-popover" side="top" align="end" sideOffset={10})
          PopoverHeader
            PopoverTitle Room to breathe
            PopoverDescription Popovers stay anchored to their trigger and adjust when space is tight. Press Escape or click outside to close.
    div(className="flex h-32 items-center justify-center rounded-xl bg-muted/30")
      div(className="flex items-center justify-center overflow-hidden rounded-lg border border-border/30 bg-surface shadow-xs" style={{ width: `${frameWidth * scale}px`, height: `${frameHeight * scale}px` }} aria-label="Frame preview")
        Icon(name="mechanics" className="size-5 text-muted-foreground")
    p.preview-note(role="status") #{`Frame: ${width || "—"} × ${height || "—"} px · ${open ? "Editing dimensions" : "Open Dimensions to edit"}`}
