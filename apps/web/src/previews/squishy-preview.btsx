import { useState } from "octane";
import Squishy from "@beast-ui/registry/ui/squishy";

props {}:{}
setup
  const [notifications, setNotifications] = useState(true)
  const [sound, setSound] = useState(false)
  const [sync, setSync] = useState(true)
div.preview-stack(className="max-w-sm")
  section.preview-section(aria-label="Squishy preference switches")
    h2.preview-label Settings with a softer touch
    div.preview-card(className="flex flex-col gap-6")
      div(className="flex items-center justify-between gap-4")
        div
          p(className="text-sm font-medium") Notifications
          p(className="mt-1 text-xs text-muted-foreground") Stay in the loop.
        Squishy(ariaLabel="Notifications" checked={notifications} onChange={setNotifications})
      div(className="flex items-center justify-between gap-4")
        div
          p(className="text-sm font-medium") Sound effects
          p(className="mt-1 text-xs text-muted-foreground") A little feedback for your actions.
        Squishy(ariaLabel="Sound effects" checked={sound} onChange={setSound} width={44} height={26} radius={13} stretch={80} trackOnColor="#8b5cf6" thumbOnColor="#ede9fe")
      div(className="flex items-center justify-between gap-4")
        div
          p(className="text-sm font-medium") Auto sync
          p(className="mt-1 text-xs text-muted-foreground") Keep everything up to date.
        Squishy(ariaLabel="Auto sync" checked={sync} onChange={setSync} width={60} height={36} radius={12} trackOnColor="#059669" thumbOnColor="#d1fae5")
      div(className="flex items-center justify-between gap-4 border-t border-sidebar-border pt-5")
        p(className="text-sm text-muted-foreground") Managed by your team
        Squishy(ariaLabel="Managed by your team" defaultChecked={true} disabled={true})
    p.preview-note(role="status") #{`${Number(notifications) + Number(sound) + Number(sync)} of 3 preferences enabled. Click, drag, or use Space to switch.`}
