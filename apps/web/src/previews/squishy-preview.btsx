import { useState } from "octane";
import Squishy from "@beast-ui/registry/ui/squishy";

props {}:{}
setup
  const [notifications, setNotifications] = useState(false)
div(className="flex flex-col items-center gap-6")
  div(className="flex flex-wrap items-center justify-center gap-6")
    Squishy(label="Notifications" size="sm" checked={notifications} onChange={setNotifications})
  p(role="status" className="text-sm text-muted-foreground select-none") #{notifications ? "Enabled" : "Disabled"}
  p(className="max-w-md text-center text-xs leading-relaxed text-muted-foreground") It squishy.
