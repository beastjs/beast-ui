import { createElement, useEffect, useMemo, useState } from 'octane'
import DataTable from './ui/table/DataTable.btsx'
import SheetFilters from './sheet-filters.btsx'
import { jsonSheetDocument, type SheetRow } from './lib/sheets.ts'
import { buildColumns, type BuildColumnsOptions } from './lib/sheet-columns.ts'
import { applyCellEdits, createCellHistory, redoCellEdit, undoCellEdit } from './ui/table/hyper/cell-history.ts'
import type { CellHistory } from './ui/table/hyper/cell-history.ts'
import type { CellValueEdit } from './ui/table/hyper/cell-selection.ts'
import './new-data-table.css'

module
  export interface NewDataTableProps {
    data: readonly Readonly<Record<string, unknown>>[] | undefined
    name?: string
    columnOptions?: BuildColumnsOptions
  }

  const PAGE_SIZES = [50, 100, 250]
  const PERSON_ICON = '<circle cx="12" cy="7.5" r="3.5"/><path d="M5 21v-3a7 7 0 0 1 14 0v3Z"/>'

props { data, name = 'Data table', columnOptions }: NewDataTableProps

setup
  const sheet = useMemo(() => data === undefined ? null : jsonSheetDocument(data, name).sheets[0], [data, name])
  const initialHistory = useMemo(() => createCellHistory(sheet?.rows ?? []), [sheet])
  const [historyState, setHistoryState] = useState(() => ({ source: sheet, history: initialHistory }))
  const history = historyState.source === sheet ? historyState.history : initialHistory
  // A replacement source starts a new editing session. URL filters/layout can
  // change freely without discarding this session's values or undo history.
  useEffect(() => {
    setHistoryState((current) => current.source === sheet ? current : { source: sheet, history: initialHistory })
  }, [sheet, initialHistory])
  const updateHistory = (update: (current: CellHistory) => CellHistory) => {
    setHistoryState((current) => {
      const previous = current.source === sheet ? current.history : initialHistory
      const next = update(previous)
      return next === previous && current.source === sheet ? current : { source: sheet, history: next }
    })
  }
  const handleCellEdits = (edits: readonly CellValueEdit[]) => updateHistory((current) => applyCellEdits(current,
    edits.map((edit) => ({
      rowIndex: /^\d+$/.test(edit.rowId) ? Number(edit.rowId) : -1,
      columnIndex: /^col-\d+$/.test(edit.columnId) ? Number(edit.columnId.slice(4)) : -1,
      value: edit.value,
    })),
  ))
  const cellEditing = {
    onEdit: handleCellEdits,
    onUndo: () => updateHistory(undoCellEdit),
    onRedo: () => updateHistory(redoCellEdit),
    canUndo: history.undo.length > 0,
    canRedo: history.redo.length > 0,
    resetKey: sheet,
  }
  const columns = useMemo(() => buildColumns(sheet?.columns ?? [], sheet?.rows ?? [], columnOptions).map((column, index) => {
    // Preserve generated ids, accessors, and filter metadata for arbitrary JSON.
    const label = sheet?.columns[index] ?? ''
    const isPerson = /^(name|client|consultant|agent)$/i.test(label)
    const header = Object.assign(() => createElement('span', { className: 'reference-column-label' },
      isPerson ? createElement('svg', {
        viewBox: '0 0 24 24', width: 20, height: 20, fill: 'none', stroke: 'currentColor',
        strokeWidth: 1.7, strokeLinecap: 'round', strokeLinejoin: 'round', 'aria-hidden': true,
        dangerouslySetInnerHTML: { __html: PERSON_ICON },
      }) : null,
      label,
    ), { headerText: label })
    return Object.assign({}, column, { header, size: index === 0 ? 280 : 250, minSize: index === 0 ? 220 : 140 })
  }), [sheet, columnOptions])

  const summary = sheet ? createElement('p', { className: 'reference-sheet-summary' },
    `${sheet.columns.length} columns · ${sheet.totalRows.toLocaleString()} rows${sheet.truncated ? ` · showing first ${sheet.rows.length.toLocaleString()}` : ''}`,
  ) : null

div(className='beast-table reference-table-page')
  div(className='reference-table-frame')
    main(aria-label='Data workspace' className='reference-workspace')
      div(className='reference-data-table')
        DataTable(
          ~ columns={columns}
          ~ data={history.rows}
          ~ cellEditing={cellEditing}
          ~ title={sheet?.name ?? 'Data table'}
          ~ showHeader={false}
          ~ filterList={SheetFilters}
          ~ toolbarSummary={summary}
          ~ selectColumnId={columns[0]?.id}
          ~ getRowId={(_row: SheetRow, index: number) => String(index)}
          ~ initialPageSize={100}
          ~ pageSizes={PAGE_SIZES}
          ~ urlKeyPrefix='sheet-'
          ~ rowClassName='reference-data-row'
          ~ viewportClassName='reference-table-viewport'
          ~ emptyTitle='No rows in this sheet'
          ~ emptyDescription='Load a sheet to view its data.'
          ~ )
