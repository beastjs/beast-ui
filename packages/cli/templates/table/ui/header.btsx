module
  type Props = {
    title: string
    eyebrow?: string
    description: string
    children?: unknown
  }
props {eyebrow, title, description, children}: Props
header(className='h-7 mt-1 flex items-center justify-between')
  div
    if eyebrow
      p(className='mb-1 text-[10px] font-semibold uppercase tracking-widest text-btable-soft') #{eyebrow}
    h2(className='font-sans font-medium text-btable-foreground/80 text-base tracking-tight leading-none') #{title}
    p(className='hidden mb-0 mt-1 max-w-[700px] text-sm leading-[1.55] text-btable-muted-foreground') #{description}
  | #{children}
