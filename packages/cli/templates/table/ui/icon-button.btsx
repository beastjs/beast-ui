import {Icon, type IconName} from '../lib/icons/index.ts'
import type {JSX} from 'octane/jsx-runtime'
module
  type IconButtonProps = {
    icon: IconName
  }
props {icon, ...props}: IconButtonProps & JSX.IntrinsicElements['button']
button(
  ~ {...props}
  ~ className='inline-flex h-8 w-9 shrink-0 cursor-pointer items-center justify-center border border-zinc-200/50 dark:border-zinc-100/10 dark:bg-btable-muted-foreground/5 rounded-[4px] bg-zinc-200/50 text-btable-foreground/80 outline-none transition-colors hover:text-btable-foreground hover:opacity-100 focus-visible:ring-[3px] focus-visible:ring-btable-ring/50 active:scale-97 transition-all duration-200 ease-out'
  ~ )
  Icon(name={icon} className='size-4.5 md:size-4 opacity-80')
