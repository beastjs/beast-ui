import type { ClassValue } from 'clsx'
import type { JSX } from 'octane/jsx-runtime'
import { cn } from '../../lib/utils.ts'

module
  type NativeTableRowProps = JSX.IntrinsicElements['tr']

  type Props = Omit<NativeTableRowProps, 'class' | 'className'> & {
    className?: ClassValue
  }

  const baseClassName = 'bg-btable-background transition-colors duration-100 hover:bg-btable-sidebar/50'

props { children, className, ...rowProps }: Props

tr(
  ~ {...rowProps}
  ~ className={cn(baseClassName, className)}
  ~ )
  | #{children}
