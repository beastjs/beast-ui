import Popover, { PopoverContent, PopoverDescription, PopoverTitle, PopoverTrigger } from '../../Popover.btsx'
import { cn } from '../../../lib/utils.ts'
import { getColumnHeaderText } from './filter-utils.ts'
import { DEFAULT_SELECT_COLUMN_ID } from './selection.ts'
import type { ColumnPinningState, OnChangeFn } from '@octanejs/tanstack-table'
import type { HyperPinningColumn } from './table-contract.ts'

module
  interface ColumnPinningProps {
    columns: HyperPinningColumn[]
    columnPinning: ColumnPinningState
    onChange: OnChangeFn<ColumnPinningState>
  }

  const TRIGGER_CLASS = 'relative flex h-8 w-9 items-center justify-center gap-1.5 rounded-[4px] border border-btable-border/50 bg-zinc-200/10 text-btable-foreground hover:border-sky-400 hover:bg-sky-200/20 focus-visible:outline-1 disabled:opacity-40 md:w-auto md:px-2'
  const POSITION_CLASS = 'rounded-xs px-2 py-1 text-xs text-btable-muted-foreground hover:bg-btable-border/30 focus-visible:outline-1'
  const ACTIVE_POSITION_CLASS = cn(POSITION_CLASS, 'bg-btable-foreground text-btable-background hover:bg-btable-foreground/90')

props { columns, columnPinning, onChange }: ColumnPinningProps

setup
  const pinnableColumns = columns.filter((column) => column.id !== DEFAULT_SELECT_COLUMN_ID && column.getCanPin())
  const startIds = new Set(columnPinning.start)
  const endIds = new Set(columnPinning.end)
  const pinnedCount = pinnableColumns.filter((column) => startIds.has(column.id) || endIds.has(column.id)).length
  const clearPins = () => {
    const managedIds = new Set(pinnableColumns.map((column) => column.id))
    onChange((current) => ({
      start: current.start.filter((id) => !managedIds.has(id)),
      end: current.end.filter((id) => !managedIds.has(id)),
    }))
  }

Popover
  PopoverTrigger(
    ~ type='button'
    ~ aria-label={pinnedCount > 0 ? `Pin columns, ${pinnedCount} pinned` : 'Pin columns'}
    ~ title='Keep columns visible while scrolling horizontally'
    ~ disabled={pinnableColumns.length === 0}
    ~ className={cn(TRIGGER_CLASS, pinnedCount > 0 && 'border-zinc-800 bg-zinc-800 text-white hover:border-zinc-800 hover:bg-zinc-800/90 dark:border-sky-100/10')}
    ~ )
    if pinnedCount > 0
      span(className='min-w-5 rounded-xs bg-sky-500 px-1 font-sans text-xs font-semibold text-white') #{pinnedCount}
    else
      svg(viewBox='0 0 24 24' fill='none' stroke='currentColor' strokeWidth={1.75} strokeLinecap='round' strokeLinejoin='round' className='size-4 opacity-80' aria-hidden='true')
        path(d='m16 3 5 5-4 2-3 5-2-2-5 5m2-10 5-3 2-4M7 8l9 9')
    span(className='hidden font-mono text-xs uppercase opacity-70 md:inline') Pin
  PopoverContent(align='start' sideOffset={7} className='w-80 max-w-[calc(100vw-24px)] gap-2 rounded-md p-0')
    PopoverTitle(className='px-3 pt-3 text-sm') Pin Columns
    PopoverDescription(className='px-3 text-xs') Keep columns on the left or right while scrolling.
    div(className='max-h-72 overflow-y-auto border-t border-btable-border' role='group' aria-label='Column pinning')
      each column in pinnableColumns key column.id
        div(className='flex min-h-10 items-center gap-2 px-3 py-1 hover:bg-btable-border/10')
          span(className='min-w-0 flex-1 truncate text-sm' title={getColumnHeaderText(column)}) #{getColumnHeaderText(column)}
          div(className='flex shrink-0 gap-0.5' role='group' aria-label={`Pin ${getColumnHeaderText(column)}`})
            button(
              ~ type='button'
              ~ aria-label={`Unpin ${getColumnHeaderText(column)}`}
              ~ aria-pressed={!startIds.has(column.id) && !endIds.has(column.id)}
              ~ className={!startIds.has(column.id) && !endIds.has(column.id) ? ACTIVE_POSITION_CLASS : POSITION_CLASS}
              ~ onClick={() => column.pin(false)}
              ~ ) None
            button(
              ~ type='button'
              ~ aria-label={`Pin ${getColumnHeaderText(column)} left`}
              ~ aria-pressed={startIds.has(column.id)}
              ~ className={startIds.has(column.id) ? ACTIVE_POSITION_CLASS : POSITION_CLASS}
              ~ onClick={() => column.pin('start')}
              ~ ) Left
            button(
              ~ type='button'
              ~ aria-label={`Pin ${getColumnHeaderText(column)} right`}
              ~ aria-pressed={endIds.has(column.id)}
              ~ className={endIds.has(column.id) ? ACTIVE_POSITION_CLASS : POSITION_CLASS}
              ~ onClick={() => column.pin('end')}
              ~ ) Right
    if pinnedCount > 0
      div(className='flex justify-end border-t border-btable-border p-2')
        button(type='button' className={POSITION_CLASS} onClick={clearPins}) Clear all pins
