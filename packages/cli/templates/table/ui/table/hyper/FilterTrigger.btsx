import {cn} from '../../../lib/utils.ts'
import {PopoverTrigger} from '../../Popover.btsx'
import {useMemo} from 'octane'
import {Icon} from '../../../lib/icons/index.ts'

module
  interface FilterTriggerProps {
    activeFilterCount: number
    activeFilterLabel: string
  }
props {activeFilterCount, activeFilterLabel}: FilterTriggerProps
setup
  const buttonClass = useMemo(() => cn(
    'relative h-8 py-1 md:w-auto flex items-center justify-center rounded-[4px]',
    'select-none text-btable-foreground text-sm md:space-x-1 md:px-2 gap-1.5 w-9',
    'border-[1.25px] border-btable-border/50 dark:border-zinc-200/2 hover:border-indigo-400',
    'bg-zinc-200/20 dark:bg-zinc-200/8 hover:bg-indigo-200/20 dark:hover:bg-btable-muted-foreground/5 dark:hover:text-indigo-300',
    'data-pressed:bg-indigo-200/40 data-pressed:border-indigo-400',
    'dark:data-pressed:text-indigo-300 dark:data-pressed:bg-zinc-900/80 dark:data-pressed:border-zinc-300/20',
    'active:bg-indigo-200/60 dark:active:bg-zinc-700/40 transition-colors duration-100',
    'focus-visible:bg-none focus-visible:-outline-offset-0 focus-visible:outline-1',
    {'gap-1 md:ps-1.5 md:pe-2 dark:md:border-indigo-200/10! border-zinc-800 bg-zinc-800 hover:border-zinc-800 hover:bg-zinc-800/90 data-pressed:border-zinc-800 data-pressed:bg-zinc-700 text-white dark:bg-indigo-100/10': activeFilterCount > 0},
  ), [activeFilterCount])
PopoverTrigger(type='button' aria-label='Filter' className={cn(buttonClass)})
  if activeFilterCount > 0
    span(className='min-w-5 rounded-xs px-1 font-sans font-semibold text-white text-xs bg-indigo-500 dark:bg-indigo-500') #{activeFilterLabel}
  else
    Icon(name='filter' className='size-4 opacity-80')
  span(className='hidden font-mono text-xs opacity-70 md:inline uppercase') Filter
