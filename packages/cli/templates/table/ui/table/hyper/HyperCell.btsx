import { cn } from '../../../lib/utils.ts'
import './cell-interaction.css'
import { flexRender } from '@octanejs/tanstack-table'
import { useEffect, useLinkedState, useRef, type OctaneNode, type Ref } from 'octane'
import { getPinnedColumnStyle } from './column-pinning.ts'
import type { DefaultColumnPinningPosition, PinnedColumnLayout } from './column-pinning.ts'
import type { HyperCellModel } from './table-contract.ts'
import type { CellInteraction } from './cell-interaction.ts'
import { isAllowedCellValue } from './cell-editor.ts'
import { getCellBadge } from './cell-badge.ts'
import { Icon } from '../../../lib/icons/index.ts'

module
  export interface HyperCellProps {
    cell: HyperCellModel
    /** False while the column is hidden. The cell stays mounted so the colgroup width can animate out. */
    isVisible: boolean
    pinnedColumnLayout?: PinnedColumnLayout
    /** Optional checkbox before the original cell content. */
    selectionControl?: OctaneNode
    interaction?: CellInteraction
  }

  // Cells must follow the row background, including hover and selection states.
  // Pinned cells also inherit it so they keep a background while scrolling.
  const CELL_CLASS = 'cursor-crosshair overflow-hidden p-0 border-b-2 border-r border-btable-table-head first:border-l-0 last:border-r-0 bg-inherit'
  const CELL_PINNED_CLASS = 'sticky z-10 border-r-0 backdrop-blur-3xl transition-[inset-inline-start,inset-inline-end] duration-200 ease-out motion-reduce:transition-none'
  const CELL_HIDDEN_CLASS = 'pointer-events-none'
  const INTERACTIVE_TARGET_SELECTOR =
    'button, input, select, textarea, a, form, label, [contenteditable="true"], [role="button"], [role="checkbox"], [role="menuitem"]'

  const CONTENT_CLASS = 'table-cell-content min-w-0 overflow-hidden py-3 ps-4 transition-all duration-180 ease-out motion-reduce:transition-none origin-left'
  const CONTENT_HIDDEN_CLASS = `${CONTENT_CLASS} opacity-0 scale-50`
  const CONTENT_VISIBLE_CLASS = `${CONTENT_CLASS} opacity-100 scale-100`

  const CELL_BOUNDARY_CLASSES = {
    start: 'border-btable-sidebar-border',
    end: 'border-l'
  } as const satisfies Record<DefaultColumnPinningPosition, string>

  // `cn` runs tailwind-merge, which is far too costly to repeat for every cell of
  // every row on every render. The cell has a bounded set of appearances, so
  // each one is merged the first time it is asked for and served from here after.
  const cellClassNames = new Map<string, string>()

  const getCellClassName = (layout: PinnedColumnLayout | undefined, isVisible: boolean) => {
    const position = layout?.position
    const isBoundary = layout?.isBoundary === true
    const cacheKey = `${position ?? 'unpinned'}:${isBoundary}:${isVisible}`
    const cached = cellClassNames.get(cacheKey)
    if (cached !== undefined) return cached

    const className = cn(
      CELL_CLASS,
      position && CELL_PINNED_CLASS,
      position && isBoundary && CELL_BOUNDARY_CLASSES[position],
      !isVisible && CELL_HIDDEN_CLASS
    )
    cellClassNames.set(cacheKey, className)

    return className
  }

  // The library's `FlexRender` component cannot be used here: its props demand a
  // nominal `Cell<TFeatures, …>`, which no feature-agnostic type satisfies. This
  // is its cell branch verbatim, over `flexRender`, which is permissive.
  const renderCellContent = (cell: HyperCellModel): OctaneNode => {
    const columnDef = cell.column.columnDef
    if (cell.getIsAggregated?.()) return flexRender(columnDef.aggregatedCell ?? columnDef.cell, cell.getContext())
    // Group headers have their own row; real rows retain values in every
    // column, including the fields used to group (and edit) them.
    if (cell.row?.getIsGrouped?.() !== false && cell.getIsPlaceholder?.()) return null

    return flexRender(columnDef.cell, cell.getContext())
  }

props { cell, isVisible, pinnedColumnLayout, selectionControl, interaction }: HyperCellProps

setup
  const pinnedPosition = pinnedColumnLayout?.position
  const cellClassName = getCellClassName(pinnedColumnLayout, isVisible)
  const cellStyle = getPinnedColumnStyle(pinnedColumnLayout)
  const contentClassName = `${isVisible ? CONTENT_VISIBLE_CLASS : CONTENT_HIDDEN_CLASS}${selectionControl ? ' flex items-center gap-3' : ''}`
  const isEditing = isVisible && interaction?.editing === true
  const cellRef = useRef<HTMLTableCellElement | null>(null)
  const inputRef = useRef<HTMLInputElement | HTMLSelectElement | null>(null)
  const draftRef = useRef(interaction?.value ?? '')
  const finishedRef = useRef(false)
  const composingRef = useRef(false)
  const preserveExternalFocusRef = useRef(false)
  const selectInitialValueRef = useRef(true)
  const pointerFocusRef = useRef(false)
  // Each edit session starts its draft from the cell's value.
  const editValue = interaction?.value ?? ''
  const [draft, setDraft] = useLinkedState(`${isEditing}|${cell.id}`, () => editValue)
  const isActive = interaction?.active === true
  const isDragging = interaction?.dragging === true
  const editorType = interaction?.editor?.type ?? 'text'
  const editorOptions = interaction?.editor?.type === 'select' ? interaction.editor.options : []
  const badge = cell.getIsAggregated?.() || (cell.row?.getIsGrouped?.() !== false && cell.getIsPlaceholder?.())
    ? undefined : getCellBadge(cell.column.columnDef.meta?.badge, cell.getValue())

  useEffect(() => {
    if (!isEditing) return
    const value = editValue
    draftRef.current = value
    finishedRef.current = false
    composingRef.current = false
    preserveExternalFocusRef.current = false
    const input = inputRef.current
    if (input) {
      // Set the initial value before selection; the controlled render follows.
      input.value = value
      input.focus()
      if (input instanceof HTMLInputElement && input.type === 'text') {
        if (selectInitialValueRef.current) input.select()
        else input.setSelectionRange(value.length, value.length)
      }
    }
    selectInitialValueRef.current = true
  }, [isEditing, editValue])

  useEffect(() => {
    if (isActive && !isDragging && isVisible && !isEditing && !preserveExternalFocusRef.current) {
      cellRef.current?.focus()
      cellRef.current?.scrollIntoView({ block: 'nearest', inline: 'nearest' })
    }
    preserveExternalFocusRef.current = false
  }, [isActive, isDragging, isVisible, isEditing])

  const isInteractiveTarget = (event: MouseEvent | KeyboardEvent | PointerEvent) =>
    event.target instanceof Element && event.target.closest(INTERACTIVE_TARGET_SELECTOR) !== null

  const handleClick = (event: MouseEvent) => {
    pointerFocusRef.current = false
    if (!interaction || !isVisible || isInteractiveTarget(event)) return
    event.stopPropagation()
    interaction.onSelect(event)
  }

  const handleCellFocus = (event: FocusEvent) => {
    if (event.target !== event.currentTarget) return
    // Pointer focus arrives before click. Let that click select with its
    // modifiers, so a Shift-click keeps the previous range anchor.
    if (pointerFocusRef.current) {
      pointerFocusRef.current = false
      return
    }
    if (interaction && isVisible && !interaction.active) interaction.onFocus?.()
  }

  const handlePointerDown = (event: PointerEvent) => {
    pointerFocusRef.current = Boolean(interaction && isVisible && event.button === 0 && !isInteractiveTarget(event))
    if (pointerFocusRef.current) interaction?.onPointerDown(event)
  }

  const handleDoubleClick = (event: MouseEvent) => {
    if (!interaction || !interaction.editable || !isVisible || isInteractiveTarget(event)) return
    event.preventDefault()
    event.stopPropagation()
    selectInitialValueRef.current = true
    interaction.onStartEdit()
  }

  const handleCellKeyDown = (event: KeyboardEvent) => {
    if (!interaction || !isVisible || isInteractiveTarget(event)) return
    // Starting with a character replaces the cell, then subsequent typing
    // continues after that character rather than replacing it a second time.
    selectInitialValueRef.current = !(event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey)
    interaction.onKeyDown(event)
  }

  const handleInput = (event: Event) => {
    const value = (event.currentTarget as HTMLInputElement).value
    draftRef.current = value
    setDraft(value)
  }

  const commit = (move?: 'up' | 'down' | 'left' | 'right') => {
    if (!interaction || finishedRef.current) return
    if (inputRef.current?.validity.badInput || !isAllowedCellValue(interaction.editor, draftRef.current)) {
      inputRef.current?.reportValidity()
      return
    }
    // Unmounting or moving focus can fire blur after a keyboard commit.
    finishedRef.current = true
    interaction.onCommit(draftRef.current, move)
  }
  const handleSelectChange = (event: Event) => {
    handleInput(event)
    commit()
  }

  const handleEditorKeyDown = (event: KeyboardEvent) => {
    event.stopPropagation()
    if (event.isComposing || composingRef.current || event.keyCode === 229) return
    if (event.key === 'Enter' || event.key === 'Tab') {
      event.preventDefault()
      commit(event.key === 'Enter' ? (event.shiftKey ? 'up' : 'down') : (event.shiftKey ? 'left' : 'right'))
    } else if (event.key === 'Escape') {
      event.preventDefault()
      finishedRef.current = true
      interaction?.onCancel()
    }
    // Editing shortcuts, including native text undo/redo, stay in the input.
  }

  const handleEditorBlur = (event: FocusEvent) => {
    const next = event.relatedTarget
    // Committing by clicking a toolbar or search control should leave focus
    // with that control; keyboard commits return focus to the active cell.
    preserveExternalFocusRef.current = next instanceof HTMLElement && !cellRef.current?.contains(next)
    if (inputRef.current?.validity.badInput || !isAllowedCellValue(interaction?.editor, draftRef.current)) {
      finishedRef.current = true
      interaction?.onCancel()
      return
    }
    commit()
  }

td(
  ~ ref={cellRef}
  ~ aria-hidden={!isVisible}
  ~ data-column-visible={isVisible}
  ~ data-column-pinned={pinnedPosition}
  ~ data-cell-id={cell.id}
  ~ data-cell-row-id={interaction?.address.rowId}
  ~ data-cell-column-id={interaction?.address.columnId}
  ~ data-cell-selected={interaction?.selected || undefined}
  ~ data-cell-active={interaction?.active || undefined}
  ~ data-cell-editing={isEditing || undefined}
  ~ data-cell-label={interaction?.label}
  ~ role={interaction ? 'gridcell' : undefined}
  ~ aria-selected={interaction?.selected}
  ~ aria-readonly={interaction ? !interaction.editable : undefined}
  ~ tabIndex={interaction && isVisible ? (interaction.active || interaction.tabbable ? 0 : -1) : undefined}
  ~ inert={!isVisible}
  ~ style={cellStyle}
  ~ className={cellClassName}
  ~ onClick={handleClick}
  ~ onPointerDown={handlePointerDown}
  ~ onFocus={handleCellFocus}
  ~ onDoubleClick={handleDoubleClick}
  ~ onKeyDown={handleCellKeyDown}
  ~ )
  div(className={contentClassName})
    if selectionControl
      span(className='table-selection-control shrink-0' data-row-selection-handle={true}) #{selectionControl}
    if isEditing
      if editorType === 'select'
        select(
          ~ ref={inputRef as Ref<HTMLSelectElement>}
          ~ className='table-cell-editor table-cell-select'
          ~ aria-label={`Edit ${interaction?.label ?? cell.column.id}`}
          ~ value={draft}
          ~ required={interaction?.editor?.required}
          ~ onChange={handleSelectChange}
          ~ onBlur={handleEditorBlur}
          ~ onKeyDown={handleEditorKeyDown}
          ~ )
          option(value='' disabled={interaction?.editor?.required}) Empty
          each optionValue in editorOptions key optionValue
            option(value={optionValue}) #{optionValue}
      else
        input(
          ~ ref={inputRef as Ref<HTMLInputElement>}
          ~ type={editorType}
          ~ step={editorType === 'number' ? 'any' : undefined}
          ~ className='table-cell-editor'
          ~ aria-label={`Edit ${interaction?.label ?? cell.column.id}`}
          ~ value={draft}
          ~ required={interaction?.editor?.required}
          ~ autoComplete='off'
          ~ spellCheck={false}
          ~ onInput={handleInput}
          ~ onBlur={handleEditorBlur}
          ~ onKeyDown={handleEditorKeyDown}
          ~ onCompositionStart={() => { composingRef.current = true }}
          ~ onCompositionEnd={() => { composingRef.current = false }}
          ~ )
    // Keep the renderer mounted while editing so custom cell descriptors stay
    // reactive when an edit or undo replaces the underlying row data.
    span(data-slot='cell-value' className={isEditing ? 'hidden' : 'min-w-0 overflow-hidden text-ellipsis'} aria-hidden={isEditing || undefined})
      if badge
        span(
          ~ data-slot='cell-badge'
          ~ data-tone={badge.tone}
          ~ className={cn('table-cell-badge', badge.className)}
          ~ style={{ color: badge.color, background: badge.background, borderColor: badge.borderColor }}
          ~ title={badge.label}
          ~ )
          if badge.icon
            Icon(name={badge.icon} className='table-cell-badge-icon')
          span(className='min-w-0 overflow-hidden text-ellipsis') #{badge.label}
      span(className={badge ? 'hidden' : undefined} aria-hidden={badge ? true : undefined}) #{renderCellContent(cell)}
