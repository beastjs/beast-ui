import type { CollisionDetector } from '@dnd-kit/collision'
import { closestCenter, closestCorners } from '@dnd-kit/collision'
import type { Data, Modifiers, UniqueIdentifier } from '@dnd-kit/abstract'
import { RestrictToHorizontalAxis, RestrictToVerticalAxis } from '@dnd-kit/abstract/modifiers'
import type { Draggable, Droppable } from '@dnd-kit/dom'
import { Accessibility } from '@dnd-kit/dom'
import { RestrictToElement } from '@dnd-kit/dom/modifiers'
import { OptimisticSortingPlugin, SortableKeyboardPlugin } from '@dnd-kit/dom/sortable'
import { DragDropProvider,
  ~ DragOverlay,
  ~ type DragDropProviderProps,
  ~ type DragEndEvent,
  ~ type DragOverlayProps } from '@octanejs/dnd-kit'
import { isSortable, useSortable } from '@octanejs/dnd-kit/sortable'
import { useRender } from '@octanejs/base-ui/use-render'
import type { JSX } from 'octane/jsx-runtime'
import { createContext,
  ~ createElement,
  ~ type CSSProperties,
  ~ createPortal,
  ~ isChildrenBlock,
  ~ isValidElement,
  ~ useContext,
  ~ useId,
  ~ useState } from 'octane'

import { cn } from '../../../lib/utils.ts'
import { useComposedRefs } from './composition.ts'

module
  const ROOT_NAME = 'Sortable'
  const CONTENT_NAME = 'SortableContent'
  const ITEM_NAME = 'SortableItem'
  const ITEM_HANDLE_NAME = 'SortableItemHandle'
  const OVERLAY_NAME = 'SortableOverlay'

  const SORTABLE_ERROR = {
    [ROOT_NAME]: `\`${ROOT_NAME}\` components must be within \`${ROOT_NAME}\``,
    [CONTENT_NAME]: `\`${CONTENT_NAME}\` must be within \`${ROOT_NAME}\``,
    [ITEM_NAME]: `\`${ITEM_NAME}\` must be within \`${CONTENT_NAME}\``,
    [ITEM_HANDLE_NAME]: `\`${ITEM_HANDLE_NAME}\` must be within \`${ITEM_NAME}\``,
    [OVERLAY_NAME]: `\`${OVERLAY_NAME}\` must be within \`${ROOT_NAME}\``,
  } as const

  type SortableName = keyof typeof SORTABLE_ERROR
  type Orientation = 'vertical' | 'horizontal' | 'mixed'
  type DivProps = JSX.IntrinsicElements['div']
  type ButtonProps = JSX.IntrinsicElements['button']
  type RenderProp = Parameters<typeof useRender<Record<string, unknown>, HTMLElement>>[0]['render']
  // type RenderProp = <E extends JSX.ElementType>() => useRender.Parameters<TState, E as JSX.Element, boolean | undefined>
  type ProviderHandler<Name extends 'onDragStart' | 'onDragMove' | 'onDragOver' | 'onDragEnd'> =
    NonNullable<DragDropProviderProps[Name]>

  interface GetItemValue<T> {
    /** Return a stable identifier for each sortable object. */
    getItemValue: (item: T) => UniqueIdentifier
  }

  /**
   * Generic for callers that name it. The root component itself is instantiated
   * as `SortableProps<any>`, because Beast has no syntax for a type parameter on
   * a component — `props <T>{ … }` does not parse.
   */
  export type SortableProps<T> = {
    id?: string
    value: T[]
    children?: unknown
    onValueChange?: (items: T[]) => void
    onMove?: (event: DragEndEvent & { activeIndex: number; overIndex: number }) => void
    onDragStart?: DragDropProviderProps['onDragStart']
    onDragMove?: DragDropProviderProps['onDragMove']
    onDragOver?: DragDropProviderProps['onDragOver']
    onDragEnd?: DragDropProviderProps['onDragEnd']
    onDragCancel?: DragDropProviderProps['onDragEnd']
    modifiers?: Modifiers
    orientation?: Orientation
    flatCursor?: boolean
  } & (T extends object ? GetItemValue<T> : Partial<GetItemValue<T>>)

  interface SortableRootContextValue {
    id: string
    items: UniqueIdentifier[]
    modifiers: Modifiers
    collisionDetector: CollisionDetector
    activeId: UniqueIdentifier | null
    flatCursor: boolean
  }

  export interface SortableContentProps extends Omit<DivProps, 'children'> {
    children?: unknown
    render?: RenderProp
    asChild?: boolean
    withoutSlot?: boolean
  }

  export interface SortableItemProps extends Omit<DivProps, 'children' | 'id' | 'style'> {
    value: UniqueIdentifier
    style?: CSSProperties
    children?: unknown
    render?: RenderProp
    asHandle?: boolean
    asChild?: boolean
    disabled?: boolean
  }

  interface SortableItemContextValue {
    id: string
    handleRef: (node: Element | null) => void
    isDragging: boolean
    disabled: boolean
  }

  export interface SortableItemHandleProps extends Omit<ButtonProps, 'children'> {
    children?: unknown
    render?: RenderProp
    asChild?: boolean
  }

  export type SortableOverlayProps = Omit<DragOverlayProps<Data, Draggable<Data>>, 'children'> & {
    container?: HTMLElement | DocumentFragment | null
    children?: ((params: { value: UniqueIdentifier }) => unknown) | unknown
  }

  const restrictToParentElement = RestrictToElement.configure({
    element: (operation) => operation.source?.element?.parentElement ?? null,
  })

  const orientationConfig: Record<Orientation, { modifiers: Modifiers; collisionDetector: CollisionDetector }> = {
    vertical: {
      modifiers: [RestrictToVerticalAxis, restrictToParentElement],
      collisionDetector: closestCenter,
    },
    horizontal: {
      modifiers: [RestrictToHorizontalAxis, restrictToParentElement],
      collisionDetector: closestCenter,
    },
    mixed: {
      modifiers: [restrictToParentElement],
      collisionDetector: closestCorners,
    },
  }

  const SortableRootContext = createContext<SortableRootContextValue | null>(null)
  const SortableContentContext = createContext(false)
  const SortableItemContext = createContext<SortableItemContextValue | null>(null)
  const SortableOverlayContext = createContext(false)

  function useSortableContext(name: SortableName) {
    const context = useContext(SortableRootContext)
    if (!context) throw new Error(SORTABLE_ERROR[name])
    return context
  }

  function arrayMove<T>(items: T[], from: number, to: number): T[] {
    const next = items.slice()
    const [item] = next.splice(from, 1)
    if (item !== undefined) next.splice(to, 0, item)
    return next
  }

  /**
   * `isSortable` is overloaded per element kind, and this is called with both a
   * drag source and a drop target. Narrowing through the draggable overload is
   * safe: `SortableDraggable` and `SortableDroppable` both carry `index`.
   */
  function sortableIndex(element: Draggable | Droppable | null | undefined): number {
    const candidate = (element ?? null) as Draggable | null
    return isSortable(candidate) ? candidate.index : 0
  }

  function wasPrevented(event: unknown): boolean {
    return Boolean((event as { defaultPrevented?: boolean }).defaultPrevented)
  }

component SortableContent
  props { children, render, asChild = false, withoutSlot = false, ref, ...contentProps }: SortableContentProps
  setup
    useSortableContext(CONTENT_NAME)
    const childIsRenderElement = asChild && isValidElement(children)
    const renderedContent = useRender({
      defaultTagName: 'div',
      render: render ?? (childIsRenderElement ? children : undefined),
      ref,
      props: {
        'data-slot': 'sortable-content',
        ...contentProps,
        children: childIsRenderElement ? undefined : children,
      },
    })
    const content = withoutSlot ? children : renderedContent

  SortableContentContext(value={true})
    | #{content}

component SortableItem
  props { value, children, render, asHandle = false, asChild = false, disabled = false, className, ref, ...itemProps }: SortableItemProps
  setup
    const inSortableContent = useContext(SortableContentContext)
    const inSortableOverlay = useContext(SortableOverlayContext)
    if (!inSortableContent && !inSortableOverlay) throw new Error(SORTABLE_ERROR[ITEM_NAME])
    if (value === '') throw new Error(`\`${ITEM_NAME}\` value cannot be an empty string`)

    const context = useSortableContext(ITEM_NAME)
    const id = useId()
    const index = context.items.indexOf(value)
    const sortable = useSortable({
      id: value,
      index: index < 0 ? 0 : index,
      group: context.id,
      disabled,
      collisionDetector: context.collisionDetector,
      plugins: [SortableKeyboardPlugin, OptimisticSortingPlugin],
    })
    const composedRef = useComposedRefs(ref, (node: HTMLElement | null) => {
      if (disabled) return
      sortable.ref(node)
      if (asHandle) sortable.handleRef(node)
    })
    const itemContext = {
      id,
      handleRef: sortable.handleRef,
      isDragging: sortable.isDragging,
      disabled,
    } as SortableItemContextValue

    const childIsRenderElement = asChild && isValidElement(children)
    const item = useRender({
      defaultTagName: 'div',
      render: render ?? (childIsRenderElement ? children : undefined),
      ref: composedRef,
      props: {
        'data-slot': 'sortable-item',
        id,
        'data-dragging': sortable.isDragging ? '' : undefined,
        ...itemProps,
        style: {
          ...(itemProps.style ?? {}),
          opacity: sortable.isDragging ? 0 : itemProps.style?.opacity,
        },
        tabIndex: disabled ? undefined : 0,
        children: childIsRenderElement ? undefined : children,
        className: cn(
          'focus-visible:outline-hidden focus-visible:ring-1 focus-visible:ring-btable-ring focus-visible:ring-offset-1',
          {
            'touch-none select-none': asHandle,
            'cursor-default': context.flatCursor,
            'data-dragging:cursor-grabbing': !context.flatCursor,
            'cursor-grab': !sortable.isDragging && asHandle && !context.flatCursor,
            'pointer-events-none opacity-0': sortable.isDragging,
            'pointer-events-none opacity-50': disabled,
          },
          className,
        ),
      },
    })

  SortableItemContext(value={itemContext})
    | #{item}

component SortableItemHandle
  props { children, render, asChild = false, disabled, className, ref, ...itemHandleProps }: SortableItemHandleProps
  setup
    const itemContext = useContext(SortableItemContext)
    if (!itemContext) throw new Error(SORTABLE_ERROR[ITEM_HANDLE_NAME])
    const context = useSortableContext(ITEM_HANDLE_NAME)
    const isDisabled = disabled ?? itemContext.disabled
    const composedRef = useComposedRefs(ref, (node: HTMLElement | null) => {
      if (!isDisabled) itemContext.handleRef(node)
    })
    const childIsRenderElement = asChild && isValidElement(children)
    const handle = useRender({
      defaultTagName: 'button',
      render: render ?? (childIsRenderElement ? children : undefined),
      ref: composedRef,
      props: {
        'data-slot': 'sortable-item-handle',
        type: 'button',
        'aria-controls': itemContext.id,
        'data-dragging': itemContext.isDragging ? '' : undefined,
        ...itemHandleProps,
        children: childIsRenderElement ? undefined : children,
        className: cn(
          'select-none disabled:pointer-events-none disabled:opacity-50',
          context.flatCursor ? 'cursor-default' : 'cursor-grab data-dragging:cursor-grabbing',
          className,
        ),
        disabled: isDisabled,
      },
    })

  | #{handle}

component SortableOverlay
  props { container: containerProp, children, className, dropAnimation = { duration: 250, easing: 'ease' }, ...overlayProps }: SortableOverlayProps
  setup
    const context = useSortableContext(OVERLAY_NAME)
    const container = containerProp ?? (typeof document === 'undefined' ? null : document.body)
    const overlayChildren = context.activeId == null
      ? null
      : typeof children === 'function' && !isChildrenBlock(children)
        ? children({ value: context.activeId })
        : children
    const overlay = createElement(
      DragOverlay,
      {
        ...overlayProps,
        className: cn(!context.flatCursor && 'cursor-grabbing', className),
        dropAnimation,
        children: createElement(SortableOverlayContext, { value: true }, overlayChildren),
      },
    )
    const portal = container ? createPortal(overlay, container) : null

  | #{portal}

module
  export { SortableContent, SortableItem, SortableItemHandle, SortableOverlay }

props { id: idProp,
  ~ value,
  ~ children,
  ~ onValueChange,
  ~ onMove,
  ~ onDragStart,
  ~ onDragMove,
  ~ onDragOver,
  ~ onDragEnd: onDragEndProp,
  ~ onDragCancel,
  ~ modifiers,
  ~ orientation = 'vertical',
  ~ flatCursor = false,
  ~ getItemValue: getItemValueProp }: SortableProps<any>
setup
  const generatedId = useId()
  const id = idProp ?? generatedId
  const [activeId, setActiveId] = useState<UniqueIdentifier | null>(null)
  const config = orientationConfig[orientation]
  const getItemValue = (item: any): UniqueIdentifier => {
    if (typeof item === 'object' && item !== null && !getItemValueProp) {
      throw new Error('getItemValue is required when using an array of objects.')
    }
    return getItemValueProp ? getItemValueProp(item) : (item as UniqueIdentifier)
  }
  const items = value.map(getItemValue)
  const activeModifiers = modifiers ?? config.modifiers

  const accessibilityOptions = {
    id,
    announcements: {
      dragstart({ operation }) {
        const source = operation.source
        const activeValue = source?.id.toString() ?? ''
        return `Grabbed sortable item "${activeValue}". Current position is ${sortableIndex(source) + 1} of ${value.length}. Use arrow keys to move, space to drop.`
      },
      dragover({ operation }) {
        const source = operation.source
        const target = operation.target
        if (source && target) {
          const overIndex = sortableIndex(target)
          const moveDirection = overIndex > sortableIndex(source) ? 'down' : 'up'
          return `Sortable item "${source.id}" moved ${moveDirection} to position ${overIndex + 1} of ${value.length}.`
        }
        return 'Sortable item is no longer over a droppable area. Press escape to cancel.'
      },
      dragmove({ operation }) {
        const source = operation.source
        const target = operation.target
        if (source && target) {
          const overIndex = sortableIndex(target)
          const moveDirection = overIndex > sortableIndex(source) ? 'down' : 'up'
          return `Sortable item "${source.id}" is moving ${moveDirection} to position ${overIndex + 1} of ${value.length}.`
        }
        return 'Sortable item is no longer over a droppable area. Press escape to cancel.'
      },
      dragend({ operation, canceled }) {
        const source = operation.source
        const activeValue = source?.id.toString() ?? ''
        if (canceled) {
          return `Sorting cancelled. Sortable item "${activeValue}" returned to position ${sortableIndex(source) + 1} of ${value.length}.`
        }
        if (operation.target) {
          return `Sortable item "${activeValue}" dropped at position ${sortableIndex(operation.target) + 1} of ${value.length}.`
        }
        return `Sortable item "${activeValue}" dropped. No changes were made.`
      },
    },
    screenReaderInstructions: {
      draggable: `
        To pick up a sortable item, press space or enter.
        While dragging, use the ${orientation === 'vertical' ? 'up and down' : orientation === 'horizontal' ? 'left and right' : 'arrow'} keys to move the item.
        Press space or enter again to drop the item in its new position, or press escape to cancel.
      `,
    },
  } as NonNullable<ConstructorParameters<typeof Accessibility>[1]>

  const accessibilityPlugin = Accessibility.configure(accessibilityOptions)
  const plugins = ((defaults) =>
    defaults.map((plugin) => (plugin === Accessibility ? accessibilityPlugin : plugin))) as DragDropProviderProps['plugins']
  const handleDragStart: ProviderHandler<'onDragStart'> = (event, manager) => {
    onDragStart?.(event, manager)
    if (!wasPrevented(event)) {
      const nextActiveId = event.operation.source?.id ?? null
      setActiveId(nextActiveId)
    }
  }
  const handleDragMove: ProviderHandler<'onDragMove'> = (event, manager) => {
    onDragMove?.(event, manager)
  }
  const handleDragOver: ProviderHandler<'onDragOver'> = (event, manager) => {
    onDragOver?.(event, manager)
  }
  const handleDragEnd: ProviderHandler<'onDragEnd'> = (event, manager) => {
    onDragEndProp?.(event, manager)
    if (event.canceled) {
      onDragCancel?.(event, manager)
      setActiveId(null)
      return
    }
    if (!wasPrevented(event)) {
      const active = event.operation.source
      const over = event.operation.target
      // `OptimisticSortingPlugin` rewrites the source's own index while it is
      // dragged, so on drop that index already IS the destination position.
      const optimisticIndex = isSortable(active) ? active.index : null
      if (active) {
        const activeIndex = value.findIndex((item) => getItemValue(item) === active.id)
        const overIndex = typeof optimisticIndex === 'number'
          ? optimisticIndex
          : over
            ? value.findIndex((item) => getItemValue(item) === over.id)
            : activeIndex
        if (activeIndex >= 0 && overIndex >= 0) {
          if (onMove)
            onMove({ ...event, activeIndex, overIndex })
          else if (activeIndex !== overIndex)
            onValueChange?.(arrayMove(value, activeIndex, overIndex))
        }
      }
    }
    setActiveId(null)
  }

  const contextValue = {
    id,
    items,
    modifiers: activeModifiers,
    collisionDetector: config.collisionDetector,
    activeId,
    flatCursor,
  } as SortableRootContextValue

SortableRootContext(value={contextValue})
  DragDropProvider(
    ~ modifiers={activeModifiers}
    ~ plugins={plugins}
    ~ onDragStart={handleDragStart}
    ~ onDragMove={handleDragMove}
    ~ onDragOver={handleDragOver}
    ~ onDragEnd={handleDragEnd}
    ~ )
    | #{children}
