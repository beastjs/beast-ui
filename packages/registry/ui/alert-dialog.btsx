module "use client";
import { AlertDialog as AlertDialogPrimitive } from "@octanejs/base-ui/alert-dialog";
import { cn } from "cn";
import Button from "./button.btsx";
import { createElement } from "octane";
import type { ComponentProps } from "octane";
module
  export { AlertDialogAction, AlertDialogCancel, AlertDialogContent, AlertDialogDescription, AlertDialogFooter, AlertDialogHeader, AlertDialogMedia, AlertDialogOverlay, AlertDialogPortal, AlertDialogTitle, AlertDialogTrigger };
component AlertDialogTrigger
  props { ...props }: AlertDialogPrimitive.Trigger.Props
  AlertDialogPrimitive.Trigger(data-slot="alert-dialog-trigger" {...props})
component AlertDialogPortal
  props { ...props }: AlertDialogPrimitive.Portal.Props
  AlertDialogPrimitive.Portal(data-slot="alert-dialog-portal" {...props})
component AlertDialogOverlay
  props { className, ...props }: AlertDialogPrimitive.Backdrop.Props
  AlertDialogPrimitive.Backdrop(
    ~ data-slot="alert-dialog-overlay"
    ~ className={cn("cn-alert-dialog-overlay fixed inset-0 isolate z-50", className)}
    ~ {...props}
    ~ )
component AlertDialogContent
  props { className, size = "default", ...props }: AlertDialogPrimitive.Popup.Props & {
    ~ size?: "default" | "sm";
    ~ }
  AlertDialogPortal
    AlertDialogOverlay
    AlertDialogPrimitive.Popup(
      ~ data-slot="alert-dialog-content"
      ~ data-size={size}
      ~ className={cn("cn-alert-dialog-content group/alert-dialog-content fixed top-1/2 left-1/2 z-50 grid w-full -translate-x-1/2 -translate-y-1/2 outline-none", className)}
      ~ {...props}
      ~ )
component AlertDialogHeader
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="alert-dialog-header" className={cn("cn-alert-dialog-header", className)} {...props})
component AlertDialogFooter
  props { className, ...props }: ComponentProps<"div">
  div(
    ~ data-slot="alert-dialog-footer"
    ~ className={cn("cn-alert-dialog-footer flex flex-col-reverse gap-2 group-data-[size=sm]/alert-dialog-content:grid group-data-[size=sm]/alert-dialog-content:grid-cols-2 sm:flex-row sm:justify-end", className)}
    ~ {...props}
    ~ )
component AlertDialogMedia
  props { className, ...props }: ComponentProps<"div">
  div(data-slot="alert-dialog-media" className={cn("cn-alert-dialog-media", className)} {...props})
component AlertDialogTitle
  props { className, ...props }: ComponentProps<typeof AlertDialogPrimitive.Title>
  AlertDialogPrimitive.Title(
    ~ data-slot="alert-dialog-title"
    ~ className={cn("cn-alert-dialog-title cn-font-heading", className)}
    ~ {...props}
    ~ )
component AlertDialogDescription
  props { className, ...props }: ComponentProps<typeof AlertDialogPrimitive.Description>
  AlertDialogPrimitive.Description(
    ~ data-slot="alert-dialog-description"
    ~ className={cn("cn-alert-dialog-description", className)}
    ~ {...props}
    ~ )
component AlertDialogAction
  props { className, ...props }: ComponentProps<typeof Button>
  Button(
    ~ data-slot="alert-dialog-action"
    ~ className={cn("cn-alert-dialog-action", className)}
    ~ {...props}
    ~ )
component Render
  props { variant, size, ...props }: ComponentProps<typeof Button>
  Button(variant={variant} size={size} {...props})
component AlertDialogCancel
  props { className, variant = "outline", size = "default", ...props }: AlertDialogPrimitive.Close.Props & Pick<ComponentProps<typeof Button>, "variant" | "size">
  AlertDialogPrimitive.Close(
    ~ data-slot="alert-dialog-cancel"
    ~ className={cn("cn-alert-dialog-cancel", className)}
    ~ render={createElement(Render, { variant, size })}
    ~ {...props}
    ~ )

props { ...props }: AlertDialogPrimitive.Root.Props
AlertDialogPrimitive.Root(data-slot="alert-dialog" {...props})
