import { cn } from "cn";
import type { ComponentProps, CSSProperties } from "octane";

props { ratio, className, ...props }: ComponentProps<"div"> & {
  ~ ratio: number;
  ~ }
div(
  ~ data-slot="aspect-ratio"
  ~ style={{
  ~ "--ratio": ratio,
  ~ } as CSSProperties}
  ~ className={cn("relative aspect-(--ratio)", className)}
  ~ {...props}
  ~ )
